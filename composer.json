{
    "name": "inilim/sqlite-parser",
    "description": "SQLite SQL parser producing typed AST on top of phplrt (target dialect: SQLite 3.54.*)",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Inilim\\SqliteParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inilim\\Test\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "inilim"
        },
        {
            "name": "Web community"
        }
    ],
    "scripts": {
        "tests": [
            "php vendor/bin/phpunit tests"
        ],
        "stan": [
            "php vendor/bin/phpstan analyze"
        ],
        "tool:tree": [
            "php cli-tools/tree.php ./ > tree.out"
        ],
        "grammar:check": [
            "php vendor/bin/phplrt check grammar/sqlite.pp3 -v"
        ],
        "grammar:build": [
            "php vendor/bin/phplrt compile grammar/sqlite.pp3 src/Parser/SqliteParser.php --class=SqliteParser --namespace=\"Inilim\\SqliteParser\\Parser\""
        ]
    },
    "require": {
        "php": "^8.4 | ^8.5 | ^8.6",
        "inilim/tools": "^0.1",
        "phplrt/runtime": "^4.2"
    },
    "require-dev": {
        "phplrt/compiler": "^4.2",
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.2",
        "symfony/finder": "^8.1"
    },
    "config": {
        "platform": {
            "php": "8.4.99"
        }
    }
}