%pragma root Script

// ============================================================================
// Токены SQLite 3.54
//
// phplrt НЕ снимает /.../ с шаблонов %token / %skip — они попадают в итоговое
// регулярное выражение как ЛИТЕРАЛЬНЫЕ слэши. Поэтому паттерны объявляются
// БЕЗ обрамляющих /.../ (raw regex), а литеральные слэши пишутся как \x2F.
//
// Порядок объявления важен:
// 1. Многосимвольные операторы ДО односимвольных префиксов.
// 2. Ключевые слова ДО T_IDENT (с \b на конце, чтобы SELECTED != SELECT).
// 3. Литералы (T_FLOAT ДО T_INT; T_BLOB ДО T_IDENT).
// 4. Комментарии ДО операторов (чтобы -- и /* не путались с -, /).
// ============================================================================

// ----------------------------------------------------------------------------
// Комментарии — объявляются первыми, чтобы -- и /* выигрывали у - и /.
// ----------------------------------------------------------------------------

%skip T_COMMENT_BLOCK \x2F\*[\s\S]*?\*\x2F
%skip T_COMMENT --[^\n]*

// ----------------------------------------------------------------------------
// Ключевые слова (регистронезависимо, (?i); \b — граница слова).
// ----------------------------------------------------------------------------

%token T_SELECT (?i)SELECT\b
%token T_FROM (?i)FROM\b
%token T_WHERE (?i)WHERE\b
%token T_ORDER (?i)ORDER\b
%token T_GROUP (?i)GROUP\b
%token T_BY (?i)BY\b
%token T_HAVING (?i)HAVING\b
%token T_LIMIT (?i)LIMIT\b
%token T_OFFSET (?i)OFFSET\b
%token T_AS (?i)AS\b
%token T_DISTINCT (?i)DISTINCT\b
%token T_ALL (?i)ALL\b
%token T_AND (?i)AND\b
%token T_OR (?i)OR\b
%token T_NOT (?i)NOT\b
%token T_IS (?i)IS\b
%token T_NULL (?i)NULL\b
%token T_IN (?i)IN\b
%token T_LIKE (?i)LIKE\b
%token T_GLOB (?i)GLOB\b
%token T_BETWEEN (?i)BETWEEN\b
%token T_EXISTS (?i)EXISTS\b
%token T_CASE (?i)CASE\b
%token T_WHEN (?i)WHEN\b
%token T_THEN (?i)THEN\b
%token T_ELSE (?i)ELSE\b
%token T_END (?i)END\b
%token T_CAST (?i)CAST\b
%token T_JOIN (?i)JOIN\b
%token T_INNER (?i)INNER\b
%token T_LEFT (?i)LEFT\b
%token T_RIGHT (?i)RIGHT\b
%token T_FULL (?i)FULL\b
%token T_OUTER (?i)OUTER\b
%token T_CROSS (?i)CROSS\b
%token T_NATURAL (?i)NATURAL\b
%token T_ON (?i)ON\b
%token T_USING (?i)USING\b
%token T_UNION (?i)UNION\b
%token T_INTERSECT (?i)INTERSECT\b
%token T_EXCEPT (?i)EXCEPT\b
%token T_INSERT (?i)INSERT\b
%token T_INTO (?i)INTO\b
%token T_VALUES (?i)VALUES\b
%token T_DEFAULT (?i)DEFAULT\b
%token T_UPDATE (?i)UPDATE\b
%token T_SET (?i)SET\b
%token T_DELETE (?i)DELETE\b
%token T_CREATE (?i)CREATE\b
%token T_TABLE (?i)TABLE\b
%token T_INDEX (?i)INDEX\b
%token T_VIEW (?i)VIEW\b
%token T_TRIGGER (?i)TRIGGER\b
%token T_ALTER (?i)ALTER\b
%token T_DROP (?i)DROP\b
%token T_RENAME (?i)RENAME\b
%token T_ADD (?i)ADD\b
%token T_COLUMN (?i)COLUMN\b
%token T_TO (?i)TO\b
%token T_PRIMARY (?i)PRIMARY\b
%token T_KEY (?i)KEY\b
%token T_FOREIGN (?i)FOREIGN\b
%token T_REFERENCES (?i)REFERENCES\b
%token T_CHECK (?i)CHECK\b
%token T_UNIQUE (?i)UNIQUE\b
%token T_AUTOINCREMENT (?i)AUTOINCREMENT\b
%token T_CONSTRAINT (?i)CONSTRAINT\b
%token T_IF (?i)IF\b
%token T_TEMP (?i)TEMP\b
%token T_TEMPORARY (?i)TEMPORARY\b
%token T_WITHOUT (?i)WITHOUT\b
%token T_ROWID (?i)ROWID\b
%token T_STRICT (?i)STRICT\b
%token T_PRAGMA (?i)PRAGMA\b
%token T_ATTACH (?i)ATTACH\b
%token T_DETACH (?i)DETACH\b
%token T_DATABASE (?i)DATABASE\b
%token T_BEGIN (?i)BEGIN\b
%token T_DEFERRED (?i)DEFERRED\b
%token T_IMMEDIATE (?i)IMMEDIATE\b
%token T_EXCLUSIVE (?i)EXCLUSIVE\b
%token T_TRANSACTION (?i)TRANSACTION\b
%token T_COMMIT (?i)COMMIT\b
%token T_ROLLBACK (?i)ROLLBACK\b
%token T_SAVEPOINT (?i)SAVEPOINT\b
%token T_RELEASE (?i)RELEASE\b
%token T_EXPLAIN (?i)EXPLAIN\b
%token T_QUERY (?i)QUERY\b
%token T_PLAN (?i)PLAN\b
%token T_RETURNING (?i)RETURNING\b
%token T_CONFLICT (?i)CONFLICT\b
%token T_DO (?i)DO\b
%token T_NOTHING (?i)NOTHING\b
%token T_RECURSIVE (?i)RECURSIVE\b
%token T_WITH (?i)WITH\b
%token T_OVER (?i)OVER\b
%token T_PARTITION (?i)PARTITION\b
%token T_RANGE (?i)RANGE\b
%token T_ROWS (?i)ROWS\b
%token T_PRECEDING (?i)PRECEDING\b
%token T_FOLLOWING (?i)FOLLOWING\b
%token T_UNBOUNDED (?i)UNBOUNDED\b
%token T_CURRENT (?i)CURRENT\b
%token T_ROW (?i)ROW\b
%token T_TRUE (?i)TRUE\b
%token T_FALSE (?i)FALSE\b
%token T_REPLACE (?i)REPLACE\b
%token T_IGNORE (?i)IGNORE\b
%token T_ABORT (?i)ABORT\b
%token T_FAIL (?i)FAIL\b
%token T_FOR (?i)FOR\b
%token T_EACH (?i)EACH\b
%token T_BEFORE (?i)BEFORE\b
%token T_AFTER (?i)AFTER\b
%token T_INSTEAD (?i)INSTEAD\b
%token T_OF (?i)OF\b

// ----------------------------------------------------------------------------
// Литералы
// ----------------------------------------------------------------------------

%token T_BLOB [xX]\x27(?:[0-9a-fA-F]{2})*\x27
%token T_FLOAT (?:\d+\.\d+(?:[eE][+-]?\d+)?|\.\d+(?:[eE][+-]?\d+)?|\d+[eE][+-]?\d+)
%token T_INT (?:0[xX][0-9a-fA-F]+|0[bB][01]+|\d+)
%token T_STRING \x27(?:[^\x27]|\x27\x27)*\x27
%token T_QUOTED_IDENT \x22(?:[^\x22]|\x22\x22)*\x22|`(?:[^`]|``)*`|\[[^\]]*\]`

// ----------------------------------------------------------------------------
// Идентификатор — объявляется ПОСЛЕ ключевых слов, иначе SELECT ловится как IDENT.
// ----------------------------------------------------------------------------

%token T_IDENT [A-Za-z_][A-Za-z0-9_]*

// ----------------------------------------------------------------------------
// Операторы (многосимвольные ДО односимвольных).
// ----------------------------------------------------------------------------

%token T_CONCAT \|\|
%token T_LSHIFT <<
%token T_RSHIFT >>
%token T_LTE <=
%token T_GTE >=
%token T_NEQ <>|!=
%token T_EQ ==|=
%token T_LT <
%token T_GT >
%token T_AMP &
%token T_PIPE \|
%token T_TILDE ~
%token T_PLUS \+
%token T_MINUS -
%token T_STAR \*
%token T_SLASH \x2F
%token T_PERCENT \x25
%token T_LPAREN \(
%token T_RPAREN \)
%token T_COMMA ,
%token T_DOT \.
%token T_SEMICOLON \x3B
%token T_COLON \x3A

%skip T_WHITESPACE \s+

// ============================================================================
// Правила
//
// Синтаксис редукторов phplrt 4.x: RuleName -> { ... } : ... ;
// Пустая альтернатива выражается через ? (zero or one) или * (zero or more),
// а не через %empty — директива %empty в PP3 не поддерживается.
//
// ВАЖНО: редуктор ставится ОДИН раз на правило, на уровне `:` — его нельзя
// размещать внутри альтернативы (`| pattern -> { ... }` недопустимо).
//
// ВАЖНО (phplrt 4.x gotcha): результат повтора `(A B)*` приходит в $children
// в одной из нескольких форм (плоская, вложенная парами, «одна пара без
// обёртки»). Поэтому редукторы, работающие со списками, должны передавать в
// Reducers::foldLeftBinaryChain ВСЁ содержимое начиная с индекса 1 — через
// `\array_slice($children, 1)`.
// ============================================================================

// ----------------------------------------------------------------------------
// Точка входа: Script
// ----------------------------------------------------------------------------

Script
    -> {
        if ($children === null) {
            return new \Inilim\SqliteParser\Ast\Script([]);
        }
        if (\is_array($children)) {
            return new \Inilim\SqliteParser\Ast\Script($children);
        }
        if ($children instanceof \Inilim\SqliteParser\Ast\Statement) {
            return new \Inilim\SqliteParser\Ast\Script([$children]);
        }

        return new \Inilim\SqliteParser\Ast\Script(
            [new \Inilim\SqliteParser\Ast\Statement\EmptyStatement()]
        );
    }
    : <T_SEMICOLON>
    | StatementList()?
    ;

StatementList
    -> {
        $children = \is_array($children) ? $children : [$children];

        $flat = [];
        \array_walk_recursive($children, static function ($item) use (&$flat): void {
            if ($item instanceof \Inilim\SqliteParser\Ast\Statement) {
                $flat[] = $item;
            }
        });

        return $flat;
    }
    : Statement() (::T_SEMICOLON:: Statement())* (::T_SEMICOLON::)?
    ;

// ----------------------------------------------------------------------------
// Statement: на этапе 5 — SELECT (одиночный и составной).
// ----------------------------------------------------------------------------

Statement
    : SelectStatement()
    ;

// ----------------------------------------------------------------------------
// SELECT (этап 5)
//
// SelectStatement (грамматика) — точка входа для SELECT-запроса. Может быть
// как одиночным SelectStatement, так и CompoundSelect (несколько ядер
// объединены UNION/INTERSECT/EXCEPT).
//
// SelectCore — одно "ядро" SELECT без WITH/ORDER BY/LIMIT. На этапе редьюсера
// возвращает объект SelectStatement с пустыми with/orderBy/limit.
// ----------------------------------------------------------------------------

SelectStatement
    -> {
        $children = \is_array($children) ? $children : [$children];

        $with    = null;
        $cores   = [];
        $ops     = [];
        $orderBy = null;
        $limit   = null;

        foreach ($children as $child) {
            if ($child instanceof \Inilim\SqliteParser\Ast\Statement\WithClause) {
                $with = $child;
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement\SelectStatement) {
                $cores[] = $child;
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement\OrderByList) {
                $orderBy = $child->items;
            } elseif (\is_array($child) && isset($child['limit'])) {
                $limit = $child;
            } elseif (\is_string($child)
                && \in_array(\strtoupper($child), ['UNION', 'UNION ALL', 'INTERSECT', 'EXCEPT'], true)
            ) {
                $ops[] = $child;
            }
        }

        if (\count($cores) === 1) {
            $core = $cores[0];
            return new \Inilim\SqliteParser\Ast\Statement\SelectStatement(
                columns: $core->columns,
                distinct: $core->distinct,
                from: $core->from,
                joins: $core->joins,
                where: $core->where,
                groupBy: $core->groupBy,
                having: $core->having,
                with: $with,
                orderBy: $orderBy,
                limit: $limit,
            );
        }

        return new \Inilim\SqliteParser\Ast\Statement\CompoundSelect(
            selects: $cores,
            operators: $ops,
            with: $with,
            orderBy: $orderBy,
            limit: $limit,
        );
    }
    : WithClause()? SelectCore() (CompoundOp() SelectCore())* OrderByClause()? LimitClause()?
    ;

SelectCore
    -> {
        $children = \is_array($children) ? $children : [$children];

        $distinct = false;
        $columns  = [];
        $from     = null;
        $joins    = [];
        $groupBy  = null;
        $exprs    = [];

        foreach ($children as $child) {
            if (\is_string($child)) {
                if (\strtoupper($child) === 'DISTINCT') {
                    $distinct = true;
                }
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement\ResultColumnList) {
                $columns = $child->items;
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement\FromClause) {
                $from  = $child->base;
                $joins = $child->joins;
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement\GroupByClause) {
                $groupBy = $child;
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Expression) {
                $exprs[] = $child;
            }
        }

        $where  = $exprs[0] ?? null;
        $having = $exprs[1] ?? null;

        return new \Inilim\SqliteParser\Ast\Statement\SelectStatement(
            columns: $columns,
            distinct: $distinct,
            from: $from,
            joins: $joins,
            where: $where,
            groupBy: $groupBy,
            having: $having,
        );
    }
    : ::T_SELECT:: DistinctModifier()? SelectList() FromClause()? WhereClause()? GroupByClause()? HavingClause()?
    ;

DistinctModifier
    -> {
        return $children instanceof \Phplrt\Contracts\Lexer\TokenInterface
            ? \strtoupper($children->value)
            : '';
    }
    : <T_DISTINCT>
    | <T_ALL>
    ;

CompoundOp
    -> {
        $children = \is_array($children) ? $children : [$children];
        $v = '';
        foreach ($children as $child) {
            if ($child instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                $u = \strtoupper($child->value);
                if ($u === 'ALL') {
                    $v .= ' ALL';
                } else {
                    $v = $u;
                }
            }
        }
        return \trim($v);
    }
    : <T_UNION> (::T_ALL::)?
    | <T_INTERSECT>
    | <T_EXCEPT>
    ;

// ----------------------------------------------------------------------------
// WITH
// ----------------------------------------------------------------------------

WithClause
    -> {
        $children = \is_array($children) ? $children : [$children];

        $recursive = false;
        $ctes      = [];

        foreach ($children as $child) {
            if ($child instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                if (\strtoupper($child->value) === 'RECURSIVE') {
                    $recursive = true;
                }
            } elseif (\is_array($child)) {
                $ctes = $child;
            }
        }

        return new \Inilim\SqliteParser\Ast\Statement\WithClause($recursive, $ctes);
    }
    : ::T_WITH:: (<T_RECURSIVE>)? CTEList()
    ;

CTEList
    -> {
        $children = \is_array($children) ? $children : [$children];

        $flat = [];
        \array_walk_recursive($children, static function ($item) use (&$flat): void {
            if ($item instanceof \Inilim\SqliteParser\Ast\Statement\CommonTableExpression) {
                $flat[] = $item;
            }
        });

        return $flat;
    }
    : CommonTableExpression() (::T_COMMA:: CommonTableExpression())*
    ;

CommonTableExpression
    -> {
        $children = \is_array($children) ? $children : [$children];

        $name    = null;
        $columns = null;
        $query   = null;

        foreach ($children as $child) {
            if (\is_string($child) && $name === null) {
                $name = $child;
            } elseif (\is_array($child)) {
                $columns = $child;
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement) {
                $query = $child;
            }
        }

        return new \Inilim\SqliteParser\Ast\Statement\CommonTableExpression(
            name: $name ?? '',
            columns: $columns,
            query: $query,
        );
    }
    : TableName() (::T_LPAREN:: IdentList() ::T_RPAREN::)? ::T_AS:: ::T_LPAREN:: SelectStatement() ::T_RPAREN::
    ;

// Список идентификаторов через запятую — возвращает list<string>.
IdentList
    -> {
        $children = \is_array($children) ? $children : [$children];

        $flat = [];
        \array_walk_recursive($children, static function ($item) use (&$flat): void {
            if ($item instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                $flat[] = $item->value;
            }
        });

        return $flat;
    }
    : <T_IDENT> (::T_COMMA:: <T_IDENT>)*
    ;

// ----------------------------------------------------------------------------
// SelectList / ResultColumn
// ----------------------------------------------------------------------------

SelectList
    -> {
        $children = \is_array($children) ? $children : [$children];

        $first = $children[0] ?? null;
        $rest  = $children[1] ?? null;

        $list = [];
        if ($first instanceof \Inilim\SqliteParser\Ast\Statement\ResultColumn) {
            $list[] = $first;
        }
        if ($rest instanceof \Inilim\SqliteParser\Ast\Statement\ResultColumnList) {
            foreach ($rest->items as $rc) {
                $list[] = $rc;
            }
        } elseif ($rest instanceof \Inilim\SqliteParser\Ast\Statement\ResultColumn) {
            $list[] = $rest;
        }

        return new \Inilim\SqliteParser\Ast\Statement\ResultColumnList($list);
    }
    : ResultColumn() (::T_COMMA:: SelectList())?
    ;

ResultColumn
    -> {
        if ($children instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
            return new \Inilim\SqliteParser\Ast\Statement\ResultColumn(
                new \Inilim\SqliteParser\Ast\Expression\Star(),
                null,
            );
        }

        $children = \is_array($children) ? $children : [$children];
        $expression = $children[0];
        $alias = null;
        if (isset($children[1]) && $children[1] instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
            $alias = $children[1]->value;
        }

        return new \Inilim\SqliteParser\Ast\Statement\ResultColumn($expression, $alias);
    }
    : Expression() (::T_AS:: <T_IDENT>)?
    | <T_STAR>
    ;

// ----------------------------------------------------------------------------
// FROM + JOIN
// ----------------------------------------------------------------------------

FromClause
    -> {
        $children = \is_array($children) ? $children : [$children];

        $base  = null;
        $joins = [];

        foreach ($children as $child) {
            if ($child instanceof \Inilim\SqliteParser\Ast\Statement\TableReference && $base === null) {
                $base = $child;
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement\JoinClause) {
                $joins[] = $child;
            }
        }

        return new \Inilim\SqliteParser\Ast\Statement\FromClause($base, $joins);
    }
    : ::T_FROM:: TableReference() (JoinClause())*
    ;

JoinClause
    -> {
        $children = \is_array($children) ? $children : [$children];

        $natural = false;
        $type    = '';
        $table   = null;
        $on      = null;
        $using   = null;

        foreach ($children as $child) {
            if ($child instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                $u = \strtoupper($child->value);
                if ($u === 'NATURAL') {
                    $natural = true;
                }
                continue;
            }
            if (\is_string($child) && \in_array($child, ['INNER', 'LEFT', 'RIGHT', 'FULL', 'CROSS'], true)) {
                $type = $child;
                continue;
            }
            if ($child instanceof \Inilim\SqliteParser\Ast\Statement\TableReference) {
                $table = $child;
                continue;
            }
            if ($child instanceof \Inilim\SqliteParser\Ast\Statement\JoinConstraint) {
                $on    = $child->on;
                $using = $child->using;
                continue;
            }
        }

        return new \Inilim\SqliteParser\Ast\Statement\JoinClause(
            type: $type,
            table: $table,
            on: $on,
            using: $using,
            natural: $natural,
        );
    }
    : (<T_NATURAL>)? (JoinType()? (::T_OUTER::)?)? ::T_JOIN:: TableReference() (JoinConstraint()?)?
    ;

JoinType
    -> {
        return $children instanceof \Phplrt\Contracts\Lexer\TokenInterface
            ? \strtoupper($children->value)
            : '';
    }
    : <T_INNER>
    | <T_LEFT>
    | <T_RIGHT>
    | <T_FULL>
    | <T_CROSS>
    ;

JoinConstraint
    -> {
        $children = \is_array($children) ? $children : [$children];

        foreach ($children as $child) {
            if ($child instanceof \Inilim\SqliteParser\Ast\Expression) {
                return new \Inilim\SqliteParser\Ast\Statement\JoinConstraint(on: $child);
            }
            if (\is_array($child)) {
                return new \Inilim\SqliteParser\Ast\Statement\JoinConstraint(using: $child);
            }
        }

        return null;
    }
    : ::T_ON:: Expression()
    | ::T_USING:: ::T_LPAREN:: IdentList() ::T_RPAREN::
    ;

TableReference
    -> {
        $children = \is_array($children) ? $children : [$children];

        $name          = null;
        $alias         = null;
        $subquery      = null;
        $columnAliases = null;
        $index         = 0;

        foreach ($children as $child) {
            if ($index === 0) {
                if (\is_string($child)) {
                    $name = $child;
                } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement) {
                    $subquery = $child;
                }
                $index = 1;
                continue;
            }

            if ($child instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                $alias = $child->value;
            } elseif (\is_array($child)) {
                $columnAliases = $child;
            }
        }

        return new \Inilim\SqliteParser\Ast\Statement\TableReference(
            name: $name,
            alias: $alias,
            subquery: $subquery,
            columnAliases: $columnAliases,
        );
    }
    : TableName() (::T_AS:: <T_IDENT>)? (::T_LPAREN:: IdentList() ::T_RPAREN::)?
    | ::T_LPAREN:: SelectStatement() ::T_RPAREN:: (::T_AS:: <T_IDENT>)? (::T_LPAREN:: IdentList() ::T_RPAREN::)?
    ;

TableName
    -> { return $children->value; }
    : <T_IDENT>
    | <T_QUOTED_IDENT>
    ;

// ----------------------------------------------------------------------------
// WHERE / GROUP BY / HAVING / ORDER BY / LIMIT
// ----------------------------------------------------------------------------

WhereClause
    : ::T_WHERE:: Expression()
    ;

GroupByClause
    -> {
        $children = \is_array($children) ? $children : [$children];

        $expressions = [];
        foreach ($children as $child) {
            if ($child instanceof \Inilim\SqliteParser\Ast\Expression\ExpressionList) {
                $expressions = $child->items;
            }
        }

        return new \Inilim\SqliteParser\Ast\Statement\GroupByClause($expressions);
    }
    : ::T_GROUP:: ::T_BY:: ExprList()
    ;

HavingClause
    : ::T_HAVING:: Expression()
    ;

OrderByClause
    -> {
        $children = \is_array($children) ? $children : [$children];

        $flat = [];
        \array_walk_recursive($children, static function ($item) use (&$flat): void {
            if ($item instanceof \Inilim\SqliteParser\Ast\Statement\OrderBy) {
                $flat[] = $item;
            }
        });

        return new \Inilim\SqliteParser\Ast\Statement\OrderByList($flat);
    }
    : ::T_ORDER:: ::T_BY:: OrderByItem() (::T_COMMA:: OrderByItem())*
    ;

OrderByItem
    -> {
        $children = \is_array($children) ? $children : [$children];
        $expression = $children[0] ?? null;
        return new \Inilim\SqliteParser\Ast\Statement\OrderBy($expression);
    }
    : Expression()
    ;

LimitClause
    -> {
        $children = \is_array($children) ? $children : [$children];
        $limit = (int) $children[0]->value;
        $offset = null;
        if (isset($children[1]) && $children[1] instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
            $offset = (int) $children[1]->value;
        }

        return ['limit' => $limit, 'offset' => $offset];
    }
    : ::T_LIMIT:: <T_INT> (::T_OFFSET:: <T_INT>)?
    ;

// ----------------------------------------------------------------------------
// Выражения: полная грамматика SQLite.
//
// Приоритеты (по возрастанию):
//   OR < AND < NOT < Comparison(= <> != < <= > >=)
//      < Additive(+ -) < Multiplicative(* / %)
//      < Unary(+ - ~) < Primary
//
// ВАЖНО: во всех редукторах OrExpr / AndExpr / Comparison / Additive /
// Multiplicative используется `\array_slice($children, 1)`.
// ----------------------------------------------------------------------------

Expression
    : OrExpr()
    ;

OrExpr
    -> {
        $children = \is_array($children) ? $children : [$children];
        $left = $children[0] ?? null;
        if (!$left instanceof \Inilim\SqliteParser\Ast\Expression) {
            return $left;
        }
        return \Inilim\SqliteParser\Grammar\Reducers::foldLeftBinaryChain(
            $left,
            \array_slice($children, 1),
            'OR',
        );
    }
    : AndExpr() (::T_OR:: AndExpr())*
    ;

AndExpr
    -> {
        $children = \is_array($children) ? $children : [$children];
        $left = $children[0] ?? null;
        if (!$left instanceof \Inilim\SqliteParser\Ast\Expression) {
            return $left;
        }
        return \Inilim\SqliteParser\Grammar\Reducers::foldLeftBinaryChain(
            $left,
            \array_slice($children, 1),
            'AND',
        );
    }
    : NotExpr() (::T_AND:: NotExpr())*
    ;

NotExpr
    -> {
        $children = \is_array($children) ? $children : [$children];
        if (isset($children[0]) && $children[0] instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
            $operand = $children[1] ?? null;
            return $operand instanceof \Inilim\SqliteParser\Ast\Expression
                ? new \Inilim\SqliteParser\Ast\Expression\UnaryOperation('NOT', $operand)
                : null;
        }
        return $children[0] ?? null;
    }
    : <T_NOT> NotExpr()
    | Comparison()
    ;

Comparison
    -> {
        $children = \is_array($children) ? $children : [$children];
        $left = $children[0] ?? null;
        if (!$left instanceof \Inilim\SqliteParser\Ast\Expression) {
            return $left;
        }
        return \Inilim\SqliteParser\Grammar\Reducers::foldLeftBinaryChain(
            $left,
            \array_slice($children, 1),
        );
    }
    : Additive() (CompareOp() Additive())*
    ;

CompareOp
    -> { return $children->value; }
    : <T_EQ>
    | <T_NEQ>
    | <T_LT>
    | <T_LTE>
    | <T_GT>
    | <T_GTE>
    ;

Additive
    -> {
        $children = \is_array($children) ? $children : [$children];
        $left = $children[0] ?? null;
        if (!$left instanceof \Inilim\SqliteParser\Ast\Expression) {
            return $left;
        }
        return \Inilim\SqliteParser\Grammar\Reducers::foldLeftBinaryChain(
            $left,
            \array_slice($children, 1),
        );
    }
    : Multiplicative() (AddOp() Multiplicative())*
    ;

AddOp
    -> { return $children->value; }
    : <T_PLUS>
    | <T_MINUS>
    ;

Multiplicative
    -> {
        $children = \is_array($children) ? $children : [$children];
        $left = $children[0] ?? null;
        if (!$left instanceof \Inilim\SqliteParser\Ast\Expression) {
            return $left;
        }
        return \Inilim\SqliteParser\Grammar\Reducers::foldLeftBinaryChain(
            $left,
            \array_slice($children, 1),
        );
    }
    : Unary() (MulOp() Unary())*
    ;

MulOp
    -> { return $children->value; }
    : <T_STAR>
    | <T_SLASH>
    | <T_PERCENT>
    ;

Unary
    -> {
        $children = \is_array($children) ? $children : [$children];
        if (isset($children[0]) && $children[0] instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
            $operand = $children[1] ?? null;
            if ($operand instanceof \Inilim\SqliteParser\Ast\Expression) {
                $op = \strtoupper($children[0]->value);
                return new \Inilim\SqliteParser\Ast\Expression\UnaryOperation($op, $operand);
            }
            return null;
        }
        return $children[0] ?? null;
    }
    : <T_PLUS> Unary()
    | <T_MINUS> Unary()
    | <T_TILDE> Unary()
    | Primary()
    ;

Primary
    -> {
        $children = \is_array($children) ? $children : [$children];
        if (empty($children)) {
            return null;
        }
        $result = $children[0];
        if (!isset($children[1])) {
            return $result;
        }
        $rest = \array_slice($children, 1);
        $postfixes = [];
        $collect = static function ($items) use (&$collect, &$postfixes): void {
            foreach ($items as $item) {
                if ($item instanceof \Closure) {
                    $postfixes[] = $item;
                } elseif (\is_array($item)) {
                    $collect($item);
                }
            }
        };
        $collect($rest);
        foreach ($postfixes as $postfix) {
            /** @var \Closure(\Inilim\SqliteParser\Ast\Expression): \Inilim\SqliteParser\Ast\Expression $postfix */
            $result = $postfix($result);
        }
        return $result;
    }
    : PrimaryBase() (PostfixOp())*
    ;

PrimaryBase
    -> {
        $children = \is_array($children) ? $children : [$children];
        return $children[0] ?? null;
    }
    : Subquery()
    | ::T_LPAREN:: Expression() ::T_RPAREN::
    | CastExpression()
    | CaseExpression()
    | FunctionCallWithOver()
    | Literal()
    | ColumnReference()
    ;

Subquery
    -> {
        $children = \is_array($children) ? $children : [$children];
        foreach ($children as $child) {
            if ($child instanceof \Inilim\SqliteParser\Ast\Statement) {
                return new \Inilim\SqliteParser\Ast\Expression\Subquery($child);
            }
        }
        return null;
    }
    : ::T_LPAREN:: SelectStatement() ::T_RPAREN::
    ;

FunctionCallWithOver
    -> {
        $children = \is_array($children) ? $children : [$children];

        $fn   = null;
        $spec = null;
        $name = null;

        foreach ($children as $child) {
            if ($child instanceof \Inilim\SqliteParser\Ast\Expression\FunctionCall) {
                $fn = $child;
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement\WindowSpecification) {
                $spec = $child;
            } elseif ($child instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                if (\strtoupper($child->value) === 'OVER') {
                    continue;
                }
                $name = $child->value;
            }
        }

        if ($fn === null) {
            return null;
        }
        if ($spec === null && $name === null) {
            return $fn;
        }

        return new \Inilim\SqliteParser\Ast\Expression\WindowFunction($fn, $spec, $name);
    }
    : FunctionCall() ::T_OVER:: (WindowSpecification() | <T_IDENT>)
    | FunctionCall()
    ;

WindowSpecification
    -> {
        $children = \is_array($children) ? $children : [$children];

        $partition = null;
        $orderBy   = null;
        $frame     = null;

        foreach ($children as $child) {
            if ($child instanceof \Inilim\SqliteParser\Ast\Expression\ExpressionList) {
                $partition = $child->items;
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement\OrderByList) {
                $orderBy = $child->items;
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement\FrameSpec) {
                $frame = $child;
            }
        }

        return new \Inilim\SqliteParser\Ast\Statement\WindowSpecification(
            partitionBy: $partition,
            orderBy: $orderBy,
            frame: $frame,
        );
    }
    : ::T_LPAREN:: (::T_PARTITION:: ::T_BY:: ExprList())? OrderByClause()? FrameSpec()? ::T_RPAREN::
    ;

FrameSpec
    -> {
        $children = \is_array($children) ? $children : [$children];

        $unit   = '';
        $bounds = [];

        foreach ($children as $child) {
            if ($child instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                $u = \strtoupper($child->value);
                if (\in_array($u, ['ROWS', 'RANGE'], true)) {
                    $unit = $u;
                }
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Statement\FrameBound) {
                $bounds[] = $child;
            }
        }

        return new \Inilim\SqliteParser\Ast\Statement\FrameSpec(
            unit: $unit,
            start: $bounds[0],
            end: $bounds[1] ?? null,
        );
    }
    : (<T_ROWS> | <T_RANGE>) FrameBound() (::T_AND:: FrameBound())?
    ;

FrameBound
    -> {
        $children = \is_array($children) ? $children : [$children];

        $prefix = '';
        $expr   = null;

        foreach ($children as $child) {
            if ($child instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                $u = \strtoupper($child->value);
                if ($u === 'UNBOUNDED') {
                    $prefix = 'UNBOUNDED';
                } elseif ($u === 'CURRENT') {
                    $prefix = 'CURRENT';
                } elseif ($u === 'ROW') {
                    $prefix .= '_ROW';
                } elseif ($u === 'PRECEDING') {
                    $prefix .= '_PRECEDING';
                } elseif ($u === 'FOLLOWING') {
                    $prefix .= '_FOLLOWING';
                }
            } elseif ($child instanceof \Inilim\SqliteParser\Ast\Expression) {
                $expr = $child;
            }
        }

        if ($expr !== null) {
            $direction = \strpos($prefix, 'FOLLOWING') !== false ? 'FOLLOWING' : 'PRECEDING';
            return new \Inilim\SqliteParser\Ast\Statement\FrameBound('EXPR_' . $direction, $expr);
        }

        return new \Inilim\SqliteParser\Ast\Statement\FrameBound($prefix);
    }
    : <T_UNBOUNDED> <T_PRECEDING>
    | <T_UNBOUNDED> <T_FOLLOWING>
    | <T_CURRENT> <T_ROW>
    | Additive() <T_PRECEDING>
    | Additive() <T_FOLLOWING>
    ;

PostfixOp
    -> {
        $children = \is_array($children) ? $children : [$children];
        $first = $children[0] ?? null;

        return function (\Inilim\SqliteParser\Ast\Expression $left) use ($children, $first): \Inilim\SqliteParser\Ast\Expression {
            if (!$first instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                return $left;
            }
            $v = \strtoupper($first->value);

            if ($v === 'IS') {
                $not = false;
                if (isset($children[1]) && $children[1] instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                    $not = \strtoupper($children[1]->value) === 'NOT';
                }
                return new \Inilim\SqliteParser\Ast\Expression\IsNullExpression($left, $not);
            }

            if ($v === 'LIKE') {
                $pattern = $children[1] ?? null;
                if ($pattern instanceof \Inilim\SqliteParser\Ast\Expression) {
                    return new \Inilim\SqliteParser\Ast\Expression\LikeExpression($left, $pattern, false, false);
                }
                return $left;
            }

            if ($v === 'GLOB') {
                $pattern = $children[1] ?? null;
                if ($pattern instanceof \Inilim\SqliteParser\Ast\Expression) {
                    return new \Inilim\SqliteParser\Ast\Expression\LikeExpression($left, $pattern, false, true);
                }
                return $left;
            }

            if ($v === 'BETWEEN') {
                $lower = $children[1] ?? null;
                $upper = $children[2] ?? null;
                if ($lower instanceof \Inilim\SqliteParser\Ast\Expression
                    && $upper instanceof \Inilim\SqliteParser\Ast\Expression
                ) {
                    return new \Inilim\SqliteParser\Ast\Expression\BetweenExpression($left, $lower, $upper, false);
                }
                return $left;
            }

            if ($v === 'IN') {
                $listRaw = $children[1] ?? null;
                if ($listRaw instanceof \Inilim\SqliteParser\Ast\Statement) {
                    return new \Inilim\SqliteParser\Ast\Expression\InExpression(
                        $left,
                        [],
                        false,
                        $listRaw,
                    );
                }
                $items = $listRaw instanceof \Inilim\SqliteParser\Ast\Expression\ExpressionList
                    ? $listRaw->items
                    : [];
                return new \Inilim\SqliteParser\Ast\Expression\InExpression($left, $items, false);
            }

            if ($v === 'NOT') {
                $second = $children[1] ?? null;
                if (!$second instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                    return $left;
                }
                $v2 = \strtoupper($second->value);
                if ($v2 === 'LIKE') {
                    $pattern = $children[2] ?? null;
                    if ($pattern instanceof \Inilim\SqliteParser\Ast\Expression) {
                        return new \Inilim\SqliteParser\Ast\Expression\LikeExpression($left, $pattern, true, false);
                    }
                    return $left;
                }
                if ($v2 === 'GLOB') {
                    $pattern = $children[2] ?? null;
                    if ($pattern instanceof \Inilim\SqliteParser\Ast\Expression) {
                        return new \Inilim\SqliteParser\Ast\Expression\LikeExpression($left, $pattern, true, true);
                    }
                    return $left;
                }
                if ($v2 === 'BETWEEN') {
                    $lower = $children[2] ?? null;
                    $upper = $children[3] ?? null;
                    if ($lower instanceof \Inilim\SqliteParser\Ast\Expression
                        && $upper instanceof \Inilim\SqliteParser\Ast\Expression
                    ) {
                        return new \Inilim\SqliteParser\Ast\Expression\BetweenExpression($left, $lower, $upper, true);
                    }
                    return $left;
                }
                if ($v2 === 'IN') {
                    $listRaw = $children[2] ?? null;
                    if ($listRaw instanceof \Inilim\SqliteParser\Ast\Statement) {
                        return new \Inilim\SqliteParser\Ast\Expression\InExpression(
                            $left,
                            [],
                            true,
                            $listRaw,
                        );
                    }
                    $items = $listRaw instanceof \Inilim\SqliteParser\Ast\Expression\ExpressionList
                        ? $listRaw->items
                        : [];
                    return new \Inilim\SqliteParser\Ast\Expression\InExpression($left, $items, true);
                }
                return $left;
            }

            return $left;
        };
    }
    : <T_IS> (<T_NOT>)? ::T_NULL::
    | <T_LIKE> Additive()
    | <T_GLOB> Additive()
    | <T_BETWEEN> Additive() ::T_AND:: Additive()
    | <T_IN> ::T_LPAREN:: ExprList()? ::T_RPAREN::
    | <T_IN> ::T_LPAREN:: SelectStatement() ::T_RPAREN::
    | <T_NOT> <T_LIKE> Additive()
    | <T_NOT> <T_GLOB> Additive()
    | <T_NOT> <T_BETWEEN> Additive() ::T_AND:: Additive()
    | <T_NOT> <T_IN> ::T_LPAREN:: ExprList()? ::T_RPAREN::
    | <T_NOT> <T_IN> ::T_LPAREN:: SelectStatement() ::T_RPAREN::
    ;

ExprList
    -> {
        $children = \is_array($children) ? $children : [$children];

        $flat = [];
        \array_walk_recursive($children, static function ($item) use (&$flat): void {
            if ($item instanceof \Inilim\SqliteParser\Ast\Expression) {
                $flat[] = $item;
            }
        });

        return new \Inilim\SqliteParser\Ast\Expression\ExpressionList($flat);
    }
    : Expression() (::T_COMMA:: Expression())*
    ;

// ----------------------------------------------------------------------------
// Первичные выражения
// ----------------------------------------------------------------------------

Literal
    : IntLiteral()
    | FloatLiteral()
    | StringLiteral()
    | NullLiteral()
    | TrueLiteral()
    | FalseLiteral()
    ;

IntLiteral
    -> { return new \Inilim\SqliteParser\Ast\Expression\Literal((int) $children->value, 'int'); }
    : <T_INT>
    ;

FloatLiteral
    -> { return new \Inilim\SqliteParser\Ast\Expression\Literal((float) $children->value, 'float'); }
    : <T_FLOAT>
    ;

StringLiteral
    -> { return new \Inilim\SqliteParser\Ast\Expression\Literal($children->value, 'string'); }
    : <T_STRING>
    ;

NullLiteral
    -> { return new \Inilim\SqliteParser\Ast\Expression\Literal(null, 'null'); }
    : <T_NULL>
    ;

TrueLiteral
    -> { return new \Inilim\SqliteParser\Ast\Expression\Literal(true, 'bool'); }
    : <T_TRUE>
    ;

FalseLiteral
    -> { return new \Inilim\SqliteParser\Ast\Expression\Literal(false, 'bool'); }
    : <T_FALSE>
    ;

ColumnReference
    -> {
        $children = \is_array($children) ? $children : [$children];

        $table = null;
        $name  = null;

        if (isset($children[1]) && $children[1] instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
            $table = $children[0]->value;
            $name  = $children[1]->value;
        } else {
            $name = $children[0]->value;
        }

        return new \Inilim\SqliteParser\Ast\Expression\ColumnReference($name, $table);
    }
    : <T_IDENT> (::T_DOT:: <T_IDENT>)?
    | <T_QUOTED_IDENT> (::T_DOT:: <T_QUOTED_IDENT>)?
    ;

FunctionCall
    -> {
        $children = \is_array($children) ? $children : [$children];

        $nameToken = $children[0] ?? null;
        if (!$nameToken instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
            return null;
        }
        $name = $nameToken->value;

        $distinct = false;
        $args = [];

        foreach (\array_slice($children, 1) as $item) {
            if ($item instanceof \Phplrt\Contracts\Lexer\TokenInterface) {
                $v = \strtoupper($item->value);
                if ($v === 'DISTINCT') {
                    $distinct = true;
                    continue;
                }
                if ($v === 'ALL') {
                    $distinct = false;
                    continue;
                }
                if ($item->value === '*') {
                    $args[] = new \Inilim\SqliteParser\Ast\Expression\Star();
                    continue;
                }
            }
            if ($item instanceof \Inilim\SqliteParser\Ast\Expression\ExpressionList) {
                foreach ($item->items as $arg) {
                    $args[] = $arg;
                }
                continue;
            }
            if ($item instanceof \Inilim\SqliteParser\Ast\Expression) {
                $args[] = $item;
                continue;
            }
        }

        return new \Inilim\SqliteParser\Ast\Expression\FunctionCall($name, $args, $distinct);
    }
    : <T_IDENT> ::T_LPAREN:: (<T_DISTINCT> | <T_ALL>)? (ExprList() | <T_STAR>)? ::T_RPAREN::
    ;

CastExpression
    -> {
        $children = \is_array($children) ? $children : [$children];
        $expression = $children[0] ?? null;
        $typeToken = $children[1] ?? null;

        if (!$expression instanceof \Inilim\SqliteParser\Ast\Expression
            || !$typeToken instanceof \Phplrt\Contracts\Lexer\TokenInterface
        ) {
            return null;
        }

        return new \Inilim\SqliteParser\Ast\Expression\CastExpression(
            $expression,
            \strtoupper($typeToken->value),
        );
    }
    : ::T_CAST:: ::T_LPAREN:: Expression() ::T_AS:: <T_IDENT> ::T_RPAREN::
    ;

CaseExpression
    -> {
        $children = \is_array($children) ? $children : [$children];

        $subject = null;
        $i = 0;
        if (isset($children[0]) && $children[0] instanceof \Inilim\SqliteParser\Ast\Expression) {
            $subject = $children[0];
            $i = 1;
        }

        $whens = [];
        $else = null;
        $count = \count($children);
        while ($i < $count) {
            $item = $children[$i];
            if ($item instanceof \Inilim\SqliteParser\Ast\Expression\WhenClause) {
                $whens[] = $item;
                $i++;
                continue;
            }
            if ($item instanceof \Inilim\SqliteParser\Ast\Expression) {
                $else = $item;
                $i++;
                continue;
            }
            $i++;
        }

        return new \Inilim\SqliteParser\Ast\Expression\CaseExpression($subject, $whens, $else);
    }
    : ::T_CASE:: Expression()? (WhenClause())+ (::T_ELSE:: Expression())? ::T_END::
    ;

WhenClause
    -> {
        $children = \is_array($children) ? $children : [$children];
        $when = $children[0] ?? null;
        $then = $children[1] ?? null;

        if (!$when instanceof \Inilim\SqliteParser\Ast\Expression
            || !$then instanceof \Inilim\SqliteParser\Ast\Expression
        ) {
            return null;
        }

        return new \Inilim\SqliteParser\Ast\Expression\WhenClause($when, $then);
    }
    : ::T_WHEN:: Expression() ::T_THEN:: Expression()
    ;