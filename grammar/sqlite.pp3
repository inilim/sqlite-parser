%pragma root Script

// ============================================================================
// Грамматика SQLite 3.54 для phplrt
//
// Этот файл — точка сборки. Все правила разбиты на тематические подфайлы,
// чтобы сократить контекст для LLM и упростить навигацию:
//
//   tokens.pp3      — лексика: %token, %skip, комментарии
//   statement.pp3   — Script, StatementList, Statement (корневые узлы)
//   select.pp3      — SELECT, FROM, JOIN, WITH, WHERE, GROUP BY, ORDER BY, LIMIT
//   expression.pp3  — выражения, приоритеты, функции, CAST, CASE, литералы
//   dml.pp3         — INSERT / UPDATE / DELETE / UPSERT
//   ddl.pp3         — CREATE / ALTER / DROP
//
// Порядок включения важен только для лексера: токены объявляются первыми,
// чтобы многосимвольные операторы и ключевые слова выигрывали у T_IDENT.
// ============================================================================

%include tokens.pp3
%include statement.pp3
%include select.pp3
%include expression.pp3
%include dml.pp3
%include ddl.pp3