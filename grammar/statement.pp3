// ============================================================================
// Точка входа и список инструкций
//
// Синтаксис редукторов phplrt 4.x: RuleName -> { ... } : ... ;
// Пустая альтернатива выражается через ? (zero or one) или * (zero or more),
// а не через %empty — директива %empty в PP3 не поддерживается.
//
// StatementItem обрабатывает два случая:
//   1. Statement() с необязательной завершающей ';' — инструкция;
//   2. <T_SEMICOLON> — «голая» точка с запятой → EmptyStatement.
//
// Использование (::T_SEMICOLON::)? внутри одной альтернативы устраняет
// неоднозначность, которая возникала при разделении на две альтернативы
// (Statement() ::T_SEMICOLON:: | Statement()).
// ============================================================================

// ----------------------------------------------------------------------------
// Точка входа: Script
// ----------------------------------------------------------------------------
Script
-> {
    if ($children === null) {
        return new \Inilim\SqliteParser\Ast\Script([]);
    }

    if (\is_array($children)) {
        return new \Inilim\SqliteParser\Ast\Script($children);
    }

    if ($children instanceof \Inilim\SqliteParser\Ast\Statement) {
        return new \Inilim\SqliteParser\Ast\Script([$children]);
    }

    return new \Inilim\SqliteParser\Ast\Script([]);
}
: StatementSequence()?
;

// ----------------------------------------------------------------------------
// StatementSequence: один или более StatementItem.
// ----------------------------------------------------------------------------
StatementSequence
-> {
    $children = \is_array($children) ? $children : [$children];

    $flat = [];
    \array_walk_recursive($children, static function ($item) use (&$flat): void {
        if ($item instanceof \Inilim\SqliteParser\Ast\Statement) {
            $flat[] = $item;
        }
    });

    return $flat;
}
: StatementItem()+
;

// ----------------------------------------------------------------------------
// StatementItem: один элемент последовательности.
//
// Альтернативы:
//   1. Инструкция с необязательной ';' — покрывает оба случая:
//      "SELECT 1;" и "SELECT 1" (последняя без точки с запятой).
//   2. Голая ';' — EmptyStatement.
// ----------------------------------------------------------------------------
StatementItem
-> {
    $children = \is_array($children) ? $children : [$children];

    foreach ($children as $child) {
        if ($child instanceof \Inilim\SqliteParser\Ast\Statement) {
            return $child;
        }
    }

    return new \Inilim\SqliteParser\Ast\Statement\EmptyStatement();
}
: Statement() (::T_SEMICOLON::)?
| <T_SEMICOLON>
;

// ----------------------------------------------------------------------------
// Statement: SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP,
//            PRAGMA, ATTACH/DETACH, транзакции, SAVEPOINT, EXPLAIN.
// ----------------------------------------------------------------------------
Statement
: SelectStatement()
| InsertStatement()
| UpdateStatement()
| DeleteStatement()
| CreateTableStatement()
| CreateIndexStatement()
| CreateViewStatement()
| CreateTriggerStatement()
| AlterTableStatement()
| DropStatement()
| PragmaStatement()
| AttachStatement()
| DetachStatement()
| TransactionStatement()
| SavepointStatement()
| ExplainStatement()
;