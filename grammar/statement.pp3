// ============================================================================
// Точка входа и список инструкций
//
// Синтаксис редукторов phplrt 4.x: RuleName -> { ... } : ... ;
// Пустая альтернатива выражается через ? (zero or one) или * (zero or more),
// а не через %empty — директива %empty в PP3 не поддерживается.
// ============================================================================

// ----------------------------------------------------------------------------
// Точка входа: Script
// ----------------------------------------------------------------------------

Script
    -> {
        if ($children === null) {
            return new \Inilim\SqliteParser\Ast\Script([]);
        }
        if (\is_array($children)) {
            return new \Inilim\SqliteParser\Ast\Script($children);
        }
        if ($children instanceof \Inilim\SqliteParser\Ast\Statement) {
            return new \Inilim\SqliteParser\Ast\Script([$children]);
        }

        return new \Inilim\SqliteParser\Ast\Script(
            [new \Inilim\SqliteParser\Ast\Statement\EmptyStatement()]
        );
    }
    : <T_SEMICOLON>
    | StatementList()?
    ;

StatementList
    -> {
        $children = \is_array($children) ? $children : [$children];

        $flat = [];
        \array_walk_recursive($children, static function ($item) use (&$flat): void {
            if ($item instanceof \Inilim\SqliteParser\Ast\Statement) {
                $flat[] = $item;
            }
        });

        return $flat;
    }
    : Statement() (::T_SEMICOLON:: Statement())* (::T_SEMICOLON::)?
    ;

// ----------------------------------------------------------------------------
// Statement: на этапе 5 — SELECT (одиночный и составной).
// ----------------------------------------------------------------------------

Statement
    : SelectStatement()
    ;